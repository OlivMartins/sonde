{
  "uid": "sonde-agents",
  "title": "Sonde — AI agent observability",
  "description": "OpenTelemetry GenAI traces stored in ClickHouse: cost, quality, reliability and safety of an agent.",
  "tags": [
    "genai",
    "opentelemetry",
    "clickhouse",
    "agents"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
