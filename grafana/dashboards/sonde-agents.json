    {
      "id": 24,
      "type": "traces",
      "title": "Trace explorer (latest run, or the trace id you clicked above)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 24,
        "h": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 3,
          "queryType": "traces",
          "pluginVersion": "4.22.1",
          "rawSql": "WITH\n    coalesce(nullIf(${trace_id:sqlstring}, ''), (SELECT argMax(TraceId, Timestamp) FROM otel.genai_agent_runs)) AS trace_id,\n    (SELECT min(Start) FROM otel.otel_traces_trace_id_ts WHERE TraceId = trace_id) AS trace_start,\n    (SELECT max(End) + 1 FROM otel.otel_traces_trace_id_ts WHERE TraceId = trace_id) AS trace_end\nSELECT\n    TraceId AS traceID,\n    SpanId AS spanID,\n    ParentSpanId AS parentSpanID,\n    ServiceName AS serviceName,\n    SpanName AS operationName,\n    multiply(toUnixTimestamp64Nano(Timestamp), 0.000001) AS startTime,\n    multiply(Duration, 0.000001) AS duration,\n    arrayMap(key -> map('key', key, 'value', SpanAttributes[key]), mapKeys(SpanAttributes)) AS tags,\n    arrayMap(key -> map('key', key, 'value', ResourceAttributes[key]), mapKeys(ResourceAttributes)) AS serviceTags,\n    if(StatusCode IN ('Error', 'STATUS_CODE_ERROR'), 2, 0) AS statusCode\nFROM otel.otel_traces\nWHERE TraceId = trace_id AND Timestamp >= trace_start AND Timestamp <= trace_end\nORDER BY startTime ASC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
