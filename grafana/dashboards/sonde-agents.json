    {
      "id": 23,
      "type": "table",
      "title": "Most expensive runs (click a trace id)",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "pluginVersion": "4.22.1",
          "rawSql": "SELECT\n    r.Timestamp AS time,\n    r.AgentVersion AS version,\n    r.TaskCategory AS category,\n    r.Outcome AS outcome,\n    r.Steps AS steps,\n    r.InputTokens + r.OutputTokens AS tokens,\n    c.CostUsd AS cost,\n    r.DurationMs / 1000 AS duration,\n    r.TraceId AS trace_id\nFROM otel.genai_agent_runs AS r\nINNER JOIN\n(\n    SELECT TraceId, sum(CostUsd) AS CostUsd\n    FROM otel.genai_llm_calls_priced\n    WHERE $__timeFilter(Timestamp)\n    GROUP BY TraceId\n) AS c ON r.TraceId = c.TraceId\nWHERE $__timeFilter(r.Timestamp)\nORDER BY c.CostUsd DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
