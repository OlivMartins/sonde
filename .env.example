# Copy to .env to override the defaults used by docker-compose.yml.

# ClickHouse credentials (shared by the collector and Grafana in this demo)
CLICKHOUSE_USER=sonde
CLICKHOUSE_PASSWORD=change-me

GRAFANA_ADMIN_PASSWORD=change-me

# Capture prompts, tool arguments and tool results (masked by the collector)
CAPTURE_MESSAGE_CONTENT=true

# LLM backend. Default: the bundled fake LLM (no API key, no cost).
# Any OpenAI-compatible endpoint works, e.g. a local Ollama:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_PROVIDER=ollama
#   AGENT_V1_MODEL=qwen3:8b
#   AGENT_V2_MODEL=llama3.2:3b
LLM_BASE_URL=http://fake-llm:8080/v1
LLM_API_KEY=
LLM_PROVIDER=fake-llm
AGENT_V1_MODEL=sim-large
AGENT_V2_MODEL=sim-mini

# Share of traffic sent to the v2 candidate (A/B test)
AGENT_V2_TRAFFIC=0.5
LOADGEN_CONCURRENCY=3

# Fake LLM behaviour at startup (also tunable live: make chaos / make calm)
FAKE_LLM_RATE_LIMIT_RATE=0.04
FAKE_LLM_LATENCY_FACTOR=1.0
